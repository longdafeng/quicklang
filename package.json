{
  "name": "quicklang",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "src/mac_ui",
    "docs"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @quicklang/ui",
    "typecheck": "npm run typecheck --workspace @quicklang/ui",
    "test": "vitest run --config tests/vitest.config.ts",
    "test:scripts": "node --test tests/unit/scripts/*.test.mjs",
    "build": "npm run build --workspace @quicklang/ui",
    "docs": "npm run build --workspace @quicklang/docs",
    "test:coverage": "vitest run --config tests/vitest.config.ts --coverage",
    "test:scripts:coverage": "node --experimental-test-coverage --test tests/unit/scripts/*.test.mjs"
  },
  "overrides": {
    "vitepress": {
      "vite": "6.4.3",
      "esbuild": "0.25.12"
    },
    "esbuild": "0.28.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.10.1",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitepress": "1.6.4",
    "vitest": "4.1.11"
  },
  "packageManager": "npm@11.12.1"
}
