{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuickLang",
  "version": "0.1.0",
  "identifier": "io.github.longdafeng.quicklang",
  "build": {
    "beforeDevCommand": {
      "script": "npm run dev --workspace @quicklang/ui",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../build/ui"
  },
  "app": {
    "windows": [
      {
        "title": "QuickLang",
        "width": 1120,
        "height": 800,
        "minWidth": 360,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "15.0"
    },
    "resources": {
      "../../NOTICE.md": "NOTICE.md",
      "../../LICENSE": "LICENSE",
      "../../deps/licenses/": "licenses/"
    }
  }
}
