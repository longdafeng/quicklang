{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: minimal core permissions; no filesystem, shell, HTTP or SQL plugins.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/longdafeng/quicklang/issues" }]
    }
  ]
}
