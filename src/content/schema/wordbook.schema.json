{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "QuickLang imported word list",
  "type": "object",
  "required": [
    "id",
    "title",
    "license",
    "entries"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ink-[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "const": "CC-BY-SA-4.0"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "spelling",
          "normalized_spelling",
          "language",
          "chapter",
          "ordinal"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 26,
            "maxLength": 26
          },
          "spelling": {
            "type": "string",
            "minLength": 1
          },
          "normalized_spelling": {
            "type": "string",
            "minLength": 1
          },
          "language": {
            "const": "en"
          },
          "chapter": {
            "type": "integer",
            "minimum": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
